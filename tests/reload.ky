# Separate VM process verifies the previous smoke run's atomic persistence.
musicOpen();
try {
const saved=jsonParse(musicLoad());
if(len(saved.playlists)!=3 || !saved.tracks[1].liked) { throw "cross-process persistence failed"; }
var invalid=false;
try { musicSave("{\"version\":1,\"tracks\":[],\"playlists\":[],\"volume\":2}"); } catch(error) { invalid=true; }
if(!invalid) { throw "invalid saved volume accepted"; }
invalid=false;
try { musicIcon("/definitely/missing/icon.png"); } catch(error) { invalid=true; }
if(!invalid) { throw "missing icon accepted"; }
invalid=false;
try { musicIcon("build/demo/catalog.json"); } catch(error) { invalid=true; }
if(!invalid) { throw "non-image icon accepted"; }
console.log("MUSIC_RELOAD_OK");

} catch(error) { throw error; }
